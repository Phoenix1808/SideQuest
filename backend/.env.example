# Any OpenAI-compatible endpoint serving an open-weight model works here.
# The model must accept images for photo checking.

# Groq (free tier, fast) - get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=qwen/qwen3.8-27b

# Alternatives - just swap the three lines above:
# Hugging Face: LLM_BASE_URL=https://router.huggingface.co/v1   LLM_MODEL=google/gemma-3-27b-it
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=gemma3:4b   (no key needed)

# Shared secret the Android app sends as X-App-Key (set the same value in android/local.properties).
# Leave empty to disable the check during local development.
APP_KEY=
